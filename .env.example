# PostgreSQL connection used by the app and Drizzle migrations.
DATABASE_URL=postgresql://contract_analyzer:contract_analyzer@localhost/contract_analyzer

# Local storage is the default for development. Set STORAGE_MODE=s3 in deployed environments.
STORAGE_MODE=local
STORAGE_LOCAL_DIR=.data/objects

# S3-compatible object storage — used by the deployed application.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# AI provider — used by the chat/agent batches.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
